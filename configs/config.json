{
  "roll_number": "P26CS0002",
  "roll": "260002",
  "seed": 260002,
  "dataset": "Olivetti faces (sklearn.datasets.fetch_olivetti_faces, shuffle=False)",
  "split": {
    "file": "data/olivetti_split.npz",
